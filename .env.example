# Copy to .env for local development:  cp .env.example .env
ENVIRONMENT=development
# docker-compose publishes Postgres on host port 5434
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5434/smart_legal_document_manager
# JSON list of allowed browser origins ("*" is rejected because the API uses cookies)
CORS_ORIGINS=["http://localhost:5173"]
# Largest accepted upload in bytes (10 MB)
MAX_UPLOAD_BYTES=10485760
